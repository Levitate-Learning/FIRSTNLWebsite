                number: "2",
                image: "ftc/2026/8.png",
                text: "Prepare a 5 minute presentation about your team and your robot. Participate in multiple Q&A team interviews.",
                html: `
                    <a target="_blank" class='btn bg-ftc-black text-white fw-bold my-1' href="https://ftc-resources.firstinspires.org/ftc/event/interview-feedback">Interview Feedback Form <i class="bi bi-box-arrow-up-right"></i></a>
                    <a target="_blank" class="btn bg-ftc-black text-white fw-bold my-1" href="https://ftc-resources.firstinspires.org/ftc/archive/2026/event/award-summary">Judging Summary Sheet <i class="bi bi-box-arrow-up-right"></i></a>
