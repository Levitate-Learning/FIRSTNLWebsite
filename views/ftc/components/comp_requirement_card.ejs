<style>
    .circle{
        border-radius: 50%;
        width: 75px;
        height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        top: -37.5px;
        align-self: center;
    }

    .requirement-img{
        width: 200px;
        bottom: 100%;
        align-self: center;
    }
</style>
<div class="d-flex flex-column h-100 position-relative">
    <img class="requirement-img text-center position-absolute" <%-IMAGE(image)%> />
    <div class="card h-100 position-relative d-flex">
        <div class="circle bg-ftc-orange fw-bold text-white fs-1"><%=number%></div>
        <div class="card-body mt-4">
            <h5 class="card-title fw-bold"><%=title%></h5>
            <p class="card-text"><%=text%></p>
            <%-html%>
        </div>
    </div>
</div>